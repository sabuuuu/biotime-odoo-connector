BIOTIME_URL=http://localhost:8083
BIOTIME_USER=admin
BIOTIME_PASS=
BIOTIME_TZ=Europe/Paris

ODOO_URL=https://votre-instance.odoo.com
ODOO_DB=votre-base
ODOO_USER=admin@societe.com
ODOO_API_KEY=
# Company whose employees are synced (empty = all companies of the API user)
ODOO_COMPANY=

DUPLICATE_MINUTES=2
# Pause = longest outing starting in this window; other outings are deducted
PAUSE_WINDOW=11:30-15:00
# Outings up to this many minutes are not deducted (quick errand)
OUTING_TOLERANCE_MINUTES=10
# Departure used when the last departure of the day was not punched
DEFAULT_CHECKOUT_TIME=18:00

WORK_DAYS=0,1,2,3
DAILY_HOURS=9

# Access-only terminals (door), ignored for attendance
TERMINALS_IGNORE=
# Terminal rules apply from this date (YYYY-MM-DD); earlier punches alternate in/out
TERMINAL_RULES_SINCE=
# Hours re-read on every run (168 = 7 days)
SYNC_LOOKBACK_HOURS=168
SYNC_START_DATE=

# Terminal clock correction: minutes added to punches in [FROM, UNTIL) (terminal time)
CLOCK_OFFSET_MINUTES=0
CLOCK_OFFSET_FROM=
CLOCK_OFFSET_UNTIL=
# Manual arrival / departure corrections (see corrections.example.csv)
CORRECTIONS_FILE=corrections.csv
